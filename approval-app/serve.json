{
  "directoryListing": false,
  "redirects": [
    {
      "source": "/README.md*",
      "destination": "/",
      "type": 301
    },
    {
      "source": "/serve.json*",
      "destination": "/",
      "type": 301
    },
    {
      "source": "/config.example.js*",
      "destination": "/",
      "type": 301
    },
    {
      "source": "/vendor/SHA256SUMS*",
      "destination": "/",
      "type": 301
    },
    {
      "source": "/.gitattributes*",
      "destination": "/",
      "type": 301
    },
    {
      "source": "/_headers*",
      "destination": "/",
      "type": 301
    }
  ],
  "headers": [
    {
      "source": "**",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'none'; script-src 'self'; style-src 'self'; connect-src http://127.0.0.1:54321; img-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ]
}
