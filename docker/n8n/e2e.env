# FinAgent OS e2e: n8n settings for the local end-to-end container only.
# Read by scripts/e2e-n8n.mjs (docker run --env-file). Never used live.
# N8N_ENCRYPTION_KEY is NOT here: the script generates one per run and keeps
# it in .local/e2e/secrets.json (git-ignored).

# Clock: every node and log line in UTC, the same zone the database uses.
GENERIC_TIMEZONE=UTC
TZ=UTC

# No telemetry, no update checks, no template gallery, no outbound calls.
N8N_DIAGNOSTICS_ENABLED=false
N8N_VERSION_NOTIFICATIONS_ENABLED=false
N8N_TEMPLATES_ENABLED=false
N8N_PERSONALIZATION_ENABLED=false
N8N_HIRING_BANNER_ENABLED=false
N8N_COMMUNITY_PACKAGES_ENABLED=false

# No editor and no public API: the e2e layer drives n8n only through the CLI
# (import, publish) and the production webhooks, so no n8n user account is
# ever created.
N8N_DISABLE_UI=true
N8N_PUBLIC_API_DISABLED=true
N8N_PUBLIC_API_SWAGGERUI_DISABLED=true

# Code nodes: n8n 2.x runs them on the built-in JavaScript task runner. The
# exports read no environment variables and load no modules, so env access
# stays blocked (the 2.x default) and no NODE_FUNCTION_ALLOW_* is set.
# Round 5 (F-32): only the separate `n8n execute` process that runs a
# harness gets N8N_BLOCK_ENV_ACCESS_IN_NODE=false and the FAO_TEST_* values
# (test/e2e/lib.mjs runHarness, its own env file); the server keeps these.
N8N_BLOCK_ENV_ACCESS_IN_NODE=true
N8N_RUNNERS_MODE=internal

# Keep every execution, success and error, so the tests can read them back.
EXECUTIONS_DATA_SAVE_ON_SUCCESS=all
EXECUTIONS_DATA_SAVE_ON_ERROR=all
EXECUTIONS_DATA_SAVE_ON_PROGRESS=false
EXECUTIONS_DATA_PRUNE=false

# Settings file permissions checked (the volume is the container's own).
N8N_ENFORCE_SETTINGS_FILE_PERMISSIONS=true

# Production webhook URLs point at the loopback port the script publishes
# (N8N_WEBHOOK_URL replaces the deprecated WEBHOOK_URL in 2.46).
N8N_WEBHOOK_URL=http://127.0.0.1:5679/
# Code-node task timeout pinned at the current 300 s default (2.46 warns the
# default will drop to 60 s).
N8N_RUNNERS_TASK_TIMEOUT=300
N8N_LOG_LEVEL=info
