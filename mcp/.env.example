# FinAgent OS MCP server settings (copy to mcp/.env; never commit .env).
# No service or secret key belongs here: the server refuses to start when
# SUPABASE_SERVICE_KEY or SUPABASE_SECRET_KEY is set.

# Supabase project URL and its PUBLIC key (publishable key live; the CLI's
# local public key locally).
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLIC_KEY=your-publishable-key

# Dedicated reader user. It must hold exactly one global `reader` role.
FAO_READER_EMAIL=mcp.reader@finagent-os.demo
FAO_READER_PASSWORD=change-me

# Optional: the human invoker the invoke tool signs in as. Leave both unset
# and invoke_reserve_recon refuses. Use a person without the approver role
# (no second factor yet: a stored approver password is enough to approve).
FAO_INVOKER_EMAIL=
FAO_INVOKER_PASSWORD=

# n8n invoke webhook (POST /webhook/fao-recon-invoke) and its header key.
N8N_INVOKE_WEBHOOK_URL=https://your-n8n.example.com/webhook/fao-recon-invoke
N8N_INVOKE_KEY=change-me
