      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// ============================================================================\n// Writer harness - Compose Valid Batch\n// ----------------------------------------------------------------------------\n// FAO-GOV-001: one STARTED plus 7 ASSET_RECONCILED events for the run just\n// claimed. The Writer must store all 8 (7 asset rows) in one batch.\n// Ids, agent and tier come from the claim result.\n// ============================================================================\n\nconst r = $('Claim').first().json.r;\nif (!r || r.ok !== true) {\n  throw new Error('FAO-GOV-008 harness: claim failed');\n}\n\nconst assets = ['ADA', 'BTC', 'ETH', 'SOL', 'USDC', 'USDT', 'XRP'];\nconst base = {\n  correlation_id: r.correlation_id,\n  execution_id: r.execution_id,\n  agent_id: r.agent_id,\n  risk_tier: r.risk_tier\n};\n\nconst items = [{\n  json: {\n    ...base,\n    event_type: 'STARTED',\n    inputs: {\n      asset_scope: assets,\n      asset_count: assets.length,\n      wallet_source: 'harness',\n      ledger_source: 'harness',\n      fixture_provenance: {}\n    },\n    policy_outcome: 'ALLOW',\n    policy_rationale: 'FAO-REC-001 writer harness run started.',\n    status: 'SUCCESS'\n  }\n}];\n\nfor (const asset of assets) {\n  items.push({\n    json: {\n      ...base,\n      event_type: 'ASSET_RECONCILED',\n      inputs: {\n        asset,\n        wallet: 100,\n        ledger: 100,\n        ratio: 1,\n        discrepancy: 0,\n        band_status: 'IN_BAND',\n        threshold: null,\n        input_problem: null\n      },\n      policy_outcome: 'ALLOW',\n      policy_rationale: `FAO-REC-006 ${asset} writer harness event.`,\n      hitl_status: 'NOT_REQUIRED',\n      status: 'SUCCESS'\n    }\n  });\n}\n\nreturn items;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1000,
