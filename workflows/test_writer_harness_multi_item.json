    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// ============================================================================\n// Writer harness - Assert Results\n// ----------------------------------------------------------------------------\n// FAO-GOV-001: the valid batch stored 8 events (STARTED plus 7 assets) and\n// the bad batch failed with the Writer's named error naming item 2.\n// Reached from both outputs of Writer: Bad Batch, so an unexpected success\n// fails here too.\n// ============================================================================\n\nconst valid = $('Writer: Valid Batch').first().json;\nconst inserted = Array.isArray(valid.inserted) ? valid.inserted : [];\nconst assetRows = inserted.filter(x => x && x.event_type === 'ASSET_RECONCILED').length;\n\nif (valid.count !== 8 || assetRows !== 7) {\n  throw new Error(`FAO-GOV-001 harness: valid batch stored ${valid.count} events and ${assetRows} asset rows, expected 8 and 7`);\n}\n\nconst bad = (($input.first() || {}).json) || {};\nconst errText = typeof bad.error === 'string'\n  ? bad.error\n  : (bad.error && typeof bad.error === 'object' ? String(bad.error.message || '') : '');\n\nif (!errText.includes('FAO-GOV-001 writer') || !errText.includes('item 2') || !errText.includes('policy_rationale')) {\n  throw new Error('FAO-GOV-001 harness: bad batch did not fail with the named error for item 2');\n}\n\nreturn [{ json: { valid_count: valid.count, asset_rows: assetRows, bad_batch_refused: true } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1800,
        0
      ],
      "id": "c796f1fa-3633-5d4c-9bbb-cda5a2ba9950",
      "name": "Assert Results"
    },
