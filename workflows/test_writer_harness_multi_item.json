      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// ============================================================================\n// Writer harness - Compose Bad Batch\n// ----------------------------------------------------------------------------\n// FAO-GOV-001 negative case: a batch whose item 2 has no policy_rationale.\n// The Writer must refuse the whole batch with a named error naming item 2\n// (0-based) and store nothing.\n// ============================================================================\n\nconst r = $('Claim').first().json.r;\nconst base = {\n  correlation_id: r.correlation_id,\n  execution_id: r.execution_id,\n  agent_id: r.agent_id,\n  risk_tier: r.risk_tier\n};\n\nconst make = (asset, withRationale) => {\n  const ev = {\n    ...base,\n    event_type: 'FAILED',\n    inputs: { failed_node: 'harness', source: 'writer', stage: 'before_request', asset },\n    policy_outcome: 'BLOCKED',\n    status: 'FAILURE'\n  };\n  if (withRationale) ev.policy_rationale = `FAO-GOV-008 writer harness negative item ${asset}.`;\n  return { json: ev };\n};\n\nreturn [make('A0', true), make('A1', true), make('A2', false)];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
