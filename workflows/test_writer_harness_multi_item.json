        "jsCode": "// ============================================================================\n// Test harness - Assert Test Environment\n// ----------------------------------------------------------------------------\n// FAO-GOV-001 / FAO-GOV-008: harnesses write real runs and ledger rows, so\n// they may run only on an n8n instance started for tests (FAO_ENV=test).\n// On any other instance this node throws before any request is made.\n// ============================================================================\n\nif (!$env || $env.FAO_ENV !== 'test') {\n  throw new Error('FAO-GOV-008 harness: FAO_ENV is not test; refusing to run');\n}\n\nreturn [{ json: { fao_env: 'test' } }];"
      },
