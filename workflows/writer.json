    {
      "parameters": {
        "jsCode": "const input = $input.first().json;\n\n// Required NOT NULL fields per shadow_ledger schema\nconst required = [\n  'correlation_id',\n  'execution_id',\n  'agent_id',\n  'risk_tier',\n  'policy_outcome',\n  'policy_rationale',\n  'status'\n];\n\nconst missing = required.filter(f => input[f] === undefined || input[f] === null || input[f] === '');\nif (missing.length > 0) {\n  throw new Error(`FAO-GOV-001 writer: missing required field(s): ${missing.join(', ')}`);\n}\n\n// Enum validation\nconst validRiskTiers = ['GREEN', 'AMBER', 'RED'];\nif (!validRiskTiers.includes(input.risk_tier)) {\n  throw new Error(`FAO-GOV-001 writer: invalid risk_tier '${input.risk_tier}'. Must be one of: ${validRiskTiers.join(', ')}`);\n}\n\nconst validPolicyOutcomes = ['ALLOW', 'ALLOW_WITH_OBLIGATIONS', 'REQUIRE_HUMAN', 'DENY', 'BLOCKED'];\nif (!validPolicyOutcomes.includes(input.policy_outcome)) {\n  throw new Error(`FAO-GOV-001 writer: invalid policy_outcome '${input.policy_outcome}'. Must be one of: ${validPolicyOutcomes.join(', ')}`);\n}\n\nconst validStatuses = ['SUCCESS', 'FAILURE', 'PARTIAL', 'ROLLED_BACK'];\nif (!validStatuses.includes(input.status)) {\n  throw new Error(`FAO-GOV-001 writer: invalid status '${input.status}'. Must be one of: ${validStatuses.join(', ')}`);\n}\n\n// UUID format check\nconst uuidPattern = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;\nif (!uuidPattern.test(input.correlation_id)) {\n  throw new Error(`FAO-GOV-001 writer: correlation_id is not a valid UUID: '${input.correlation_id}'`);\n}\nif (!uuidPattern.test(input.execution_id)) {\n  throw new Error(`FAO-GOV-001 writer: execution_id is not a valid UUID: '${input.execution_id}'`);\n}\n\n// Normalize — fill optional nulls\nconst normalized = {\n  correlation_id: input.correlation_id,\n  execution_id: input.execution_id,\n  agent_id: input.agent_id,\n  risk_tier: input.risk_tier,\n  inputs: input.inputs ?? {},\n  ai_prompt: input.ai_prompt ?? null,\n  ai_output: input.ai_output ?? null,\n  ai_confidence: input.ai_confidence ?? null,\n  fractional_cost_usd: input.fractional_cost_usd ?? null,\n  policy_outcome: input.policy_outcome,\n  policy_sub_tier: input.policy_sub_tier ?? null,\n  policy_rationale: input.policy_rationale,\n  obligations: input.obligations ?? [],\n  hitl_status: input.hitl_status ?? 'NOT_REQUIRED',\n  hitl_approver_id: input.hitl_approver_id ?? null,\n  status: input.status,\n  error_details: input.error_details ?? null\n};\n\nreturn [{ json: normalized }];"
      },
